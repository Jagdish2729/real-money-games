generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus { ACTIVE SUSPENDED BLOCKED }
enum WalletTransactionType { DEPOSIT WITHDRAWAL GAME_STAKE GAME_WIN REFUND ADJUSTMENT }
enum WalletTransactionStatus { PENDING COMPLETED REJECTED REVERSED }
enum DepositStatus { PENDING APPROVED REJECTED }
enum WithdrawalStatus { PENDING PROCESSING PAID REJECTED }
enum GameType { DICE COIN_TOSS }
enum GameStatus { RESOLVED REFUNDED }

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @default("") @db.VarChar(100)
  email           String?  @unique @db.VarChar(255)
  phoneNumber     String   @unique @db.VarChar(15)
  passwordHash    String?  @db.VarChar(255)
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wallet          Wallet?
  otpRequests     OtpRequest[]
  passwordResets  PasswordReset[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
  transactions    WalletTransaction[]
  games           Game[]
  @@index([status])
}

model OtpRequest {
  id String @id @default(uuid())
  userId String? @db.Uuid
  phoneNumber String @db.VarChar(15)
  codeHash String @db.VarChar(255)
  expiresAt DateTime
  verifiedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([phoneNumber, createdAt])
  @@index([expiresAt])
}

model PasswordReset {
  id String @id @default(uuid())
  userId String @db.Uuid
  tokenHash String @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Wallet {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  balancePaise BigInt @default(0)
  lockedPaise BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  @@index([updatedAt])
}

model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  userId String @db.Uuid
  type WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)
  amountPaise BigInt
  balanceBefore BigInt
  balanceAfter BigInt
  referenceId String? @unique @db.VarChar(100)
  description String? @db.VarChar(500)
  createdAt DateTime @default(now())
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([type, status])
}

model Deposit {
  id String @id @default(uuid())
  userId String @db.Uuid
  amountPaise BigInt
  utr String @unique @db.VarChar(100)
  proofUrl String? @db.VarChar(1000)
  status DepositStatus @default(PENDING)
  reviewedAt DateTime?
  rejectionReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Withdrawal {
  id String @id @default(uuid())
  userId String @db.Uuid
  amountPaise BigInt
  upiId String @db.VarChar(255)
  status WithdrawalStatus @default(PENDING)
  reviewedAt DateTime?
  rejectionReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Game {
  id String @id @default(uuid())
  userId String @db.Uuid
  type GameType
  status GameStatus @default(RESOLVED)
  prediction Int
  result Int
  stakePaise BigInt
  payoutPaise BigInt @default(0)
  referenceId String @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model PaymentSetting {
  id Int @id @default(1)
  upiId String @db.VarChar(255)
  qrImageUrl String? @db.VarChar(1000)
  instructions String @db.VarChar(1000)
  updatedAt DateTime @updatedAt
}
